"""Apex Neural Rendering's public tools: nr-record (record/README.md). Third-party sources are pinned: Bazel Central
Registry modules and the LLVM release toolchains_llvm downloads."""

module(name = "anr")

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "zstd", version = "1.5.7.bcr.3")
bazel_dep(name = "toolchains_llvm", version = "1.13.0")

# Clang compiles the C++. Linux: LLVM 23.1.5 from toolchains_llvm with the host's libstdc++ linked statically and the
# host's glibc. Windows: clang-cl from an LLVM install (BAZEL_LLVM) with Visual Studio's C++ library and Windows SDK
# (.bazelrc: build:windows), or cross-compiled on Linux (--config=windows_cross, tools/windows_cross/README.md).
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    cxx_standard = {"": "c++20"},
    llvm_version = "23.1.5",
    stdlib = {"": "stdc++"},
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all")

# Windows x64 on Linux: the pinned LLVM's clang-cl and lld-link with the MSVC C runtime and Windows SDK that xwin
# downloads from Microsoft. Fetched only for --config=windows_cross builds; fetching it accepts Microsoft's license
# terms for those files (tools/windows_cross/README.md).
windows_cross = use_repo_rule("//tools/windows_cross:windows_cross.bzl", "windows_cross")

windows_cross(
    name = "windows_cross",
    clang = "@llvm_toolchain_llvm//:bin/clang",
    crt_version = "14.51",
    manifest_version = "18",
    sdk_version = "10.0.28000",
    xwin_sha256 = "d870eb4b2f390878af6da1ccd3cf321d22fcb72720984853b4be732ae597fc88",
    xwin_strip_prefix = "xwin-0.10.0-x86_64-unknown-linux-musl",
    xwin_url = "https://github.com/Jake-Shadle/xwin/releases/download/0.10.0/xwin-0.10.0-x86_64-unknown-linux-musl.tar.gz",
)

# Archives with BUILD files in third_party/ (module.d's parts add them).
