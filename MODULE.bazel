# at run time), NRI with NRIFramework and MathLib, ImGui, the Vulkan loader built from source, and on macOS metal-cpp and
# DXC built from source (rules_foreign_cc) for its DXIL shaders.
bazel_dep(name = "libexpat", version = "2.9.0")  # wayland-scanner
bazel_dep(name = "sdl3", version = "3.4.20")
bazel_dep(name = "rules_foreign_cc", version = "0.17.0")

# SDL 3.4.20 with the Bazel build of the BCR's sdl3 3.4.18.bcr.1 (the BCR has no 3.4.20 yet; no source files were
# added or removed in between), and SDL3 with libdecor on Wayland (window decorations where the compositor draws
# none, as on GNOME), which the BCR build leaves out.
archive_override(
    module_name = "sdl3",
    integrity = "sha256-87sG9VvtlVcienAK8upi5JSX699YA3cypzGl+z74WB8=",
    patch_strip = 1,
    patches = [
        "//third_party:sdl3_bcr_overlay.patch",  # the BCR overlay's files, with version 3.4.20 in its MODULE.bazel
        "//third_party:sdl3_bcr_testprocess.patch",  # the BCR's patch
        "//third_party:sdl3_libdecor_module.patch",  # libdecor's header, pinned
        "//third_party:sdl3_libdecor_build.patch",  # SDL's dynamic libdecor support
        "//third_party:sdl3_scroll_source.patch",  # native touch-surface identification in wheel events
    ],
    strip_prefix = "SDL3-3.4.20",
    urls = ["https://github.com/libsdl-org/SDL/releases/download/release-3.4.20/SDL3-3.4.20.tar.gz"],
)

# NRI (NVIDIA Render Interface), and NRIFramework with MathLib, at the commits NRISamples 8ba0e4e uses (NRI main of
# 7 November 2026, 9 commits after its v191 release; NRIFramework f313ac8 only moves its NRI submodule to that commit).
http_archive(
    name = "nri",
    build_file = "//third_party:nri.BUILD",
    # D3D12 with the Agility SDK 1.721 preview's headers (below), which declare no ID3D12Device16 or
    # ID3D12GraphicsCommandList12: the newest interfaces they have. HDR swap chains: nri_hdr.patch's header.
    patch_args = ["-p1"],
    # Compute pipelines with a required subgroup size (AMD's 64-lane default): nri_subgroup_size.patch. A Vulkan game's
    # device, whose enabled features are not known: nri_unknown_features.patch.
    patches = ["//third_party:nri_agility_721.patch", "//third_party:nri_hdr.patch", "//third_party:nri_hdr_metadata.patch",
               "//third_party:nri_subgroup_size.patch", "//third_party:nri_unknown_features.patch"],
    sha256 = "984eedb87a3e116f260e555cb263aa0fce5c0823058705b4528450c3607713e1",
    strip_prefix = "NRI-a20efc8f7c6e4e6045acd6f29bf90b0d26ac3df5",
    urls = ["https://github.com/NVIDIA-RTX/NRI/archive/a20efc8f7c6e4e6045acd6f29bf90b0d26ac3df5.zip"],
)

http_archive(
