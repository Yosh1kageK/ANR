+#ifdef SDL_VIDEO_DRIVER_X11_XINPUT2_SUPPORTS_SCROLLINFO
+static bool xinput2_has_touchpad_property(SDL_VideoData *videodata, int device_id)
+{
+    // Xorg touchpad drivers do not all expose XIDependentTouch. These properties exist only on touchpads;
+    // a disabled tapping setting still identifies the device. No name matching or delta-size heuristic.
+    const char *properties[] = {"libinput Tapping Enabled", "Synaptics Capabilities"};
+    for (int i = 0; i < SDL_arraysize(properties); ++i) {
+        const Atom property = X11_XInternAtom(videodata->display, properties[i], True);
+        if (property != None) {
+            Atom type = None;
+            int format;
+            unsigned long items, remaining;
+            unsigned char *value = NULL;
+            const int status = X11_XIGetProperty(videodata->display, device_id, property, 0, 0, False,
+                                               AnyPropertyType, &type, &format, &items, &remaining, &value);
+            if (value) {
+                X11_XFree(value);
+            }
+            if (status == Success && type != None) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+#endif
