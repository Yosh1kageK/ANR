+// Vulkan 1.0's barrier flags and layouts for "synchronization2"'s (devices without it): the bits below 32 are the same
+static inline VkPipelineStageFlags GetPipelineStageFlags1(VkPipelineStageFlags2 stages) {
+    VkPipelineStageFlags flags = (VkPipelineStageFlags)(stages & 0xFFFFFFFFull);
+
+    if (stages & (VK_PIPELINE_STAGE_2_COPY_BIT | VK_PIPELINE_STAGE_2_RESOLVE_BIT | VK_PIPELINE_STAGE_2_BLIT_BIT | VK_PIPELINE_STAGE_2_CLEAR_BIT))
+        flags |= VK_PIPELINE_STAGE_TRANSFER_BIT;
+    if (stages & (VK_PIPELINE_STAGE_2_INDEX_INPUT_BIT | VK_PIPELINE_STAGE_2_VERTEX_ATTRIBUTE_INPUT_BIT))
+        flags |= VK_PIPELINE_STAGE_VERTEX_INPUT_BIT;
+    if (stages & VK_PIPELINE_STAGE_2_PRE_RASTERIZATION_SHADERS_BIT)
+        flags |= VK_PIPELINE_STAGE_VERTEX_SHADER_BIT;
+
+    return flags;
+}
+
+static inline VkAccessFlags GetAccessFlags1(VkAccessFlags2 access) {
+    VkAccessFlags flags = (VkAccessFlags)(access & 0xFFFFFFFFull);
+
+    if (access & (VK_ACCESS_2_SHADER_SAMPLED_READ_BIT | VK_ACCESS_2_SHADER_STORAGE_READ_BIT))
+        flags |= VK_ACCESS_SHADER_READ_BIT;
+    if (access & VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT)
+        flags |= VK_ACCESS_SHADER_WRITE_BIT;
+
+    return flags;
+}
+
+static inline VkImageLayout GetImageLayout1(VkImageLayout layout, bool depthStencil) {
+    if (layout == VK_IMAGE_LAYOUT_ATTACHMENT_OPTIMAL)
+        return depthStencil ? VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL : VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    if (layout == VK_IMAGE_LAYOUT_READ_ONLY_OPTIMAL)
+        return depthStencil ? VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL : VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+
+    return layout;
+}
+
