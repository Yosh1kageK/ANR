+    checks.AC_DEFINE("SDL_VIDEO_DRIVER_X11_DYNAMIC_XRANDR", '"libXrandr.so.2"'),
+    checks.AC_DEFINE("SDL_VIDEO_DRIVER_X11_HAS_XKBLIB", "1"),
+    checks.AC_DEFINE("SDL_VIDEO_DRIVER_X11_SUPPORTS_GENERIC_EVENTS", "1"),
