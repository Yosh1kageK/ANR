# --- Shaders ----------------------------------------------------------------------------------------------------------

ENTRIES = [
    "fullscreen_vs:vertex",
    "video_fs:fragment",
    "raw_fs:fragment",
    "ui_layer_fs:fragment",
    "still_fs:fragment",  # captures/stills.slang, the Captures tab's picture pass
]

# Vulkan (Linux, Windows): SPIR-V with the HLSL registers shifted to NRI's Vulkan binding offsets (as renderer/BUILD.bazel).
# Metal (macOS): DXIL, whose registers NRI maps itself.
slang_spirv(
    name = "shaders",
    src = "clips.slang",
    deps = ["//renderer:display_common.slang", "//renderer/clips/captures:stills.slang"],
    copts = [
        "-fvk-s-shift", "0", "all",
        "-fvk-t-shift", "128", "all",
        "-fvk-b-shift", "32", "all",
        "-fvk-u-shift", "64", "all",
        "-matrix-layout-column-major",
        "-warnings-disable", "39001",  # entry points share registers (each uses its own)
    ],
    entries = ENTRIES,
)

slang_dxil(
    name = "shaders_dxil",
    src = "clips.slang",
    deps = ["//renderer:display_common.slang", "//renderer/clips/captures:stills.slang"],
    dxil_copts = [
        "-matrix-layout-column-major",
        "-warnings-disable", "39001",
    ],
    entries = ENTRIES,
)

